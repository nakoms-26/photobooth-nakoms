generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model SessionData {
  id         String   @id @default(cuid())
  pngPath    String   @db.Text // URL/Path ke gambar PNG
  gifPath    String   @db.Text // URL/Path ke gambar GIF
  photo1Path String?  @db.Text // URL/Path ke Foto Mentahan 1
  photo2Path String?  @db.Text // URL/Path ke Foto Mentahan 2
  photo3Path String?  @db.Text // URL/Path ke Foto Mentahan 3
  createdAt  DateTime @default(now())
}

